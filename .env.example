# Copy to .env.local and fill in real values. Never commit .env.local.

# Database
MONGODB_URI=mongodb://localhost:27017/portfolio
MONGODB_NAME=portfolio

# App
APP_NAME=Portfolio

# Auth — generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_SALT_ROUNDS=10

# Cron — protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Seed admin (used by lib/scripts/seed-admin.ts)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Mail (nodemailer SMTP). For Gmail use a 16-char App Password, not the account
# password. Port 587 → MAIL_SECURE=false (STARTTLS); port 465 → MAIL_SECURE=true.
# MAIL_FROM and MAIL_TO fall back to MAIL_USER when left blank.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
